# Files that live in this repo but must NOT be distributed to clients.
# packwiz indexes every file in the pack directory unless listed here.
# (Dotfiles such as .gitignore/.gitattributes are already skipped by default.)
#
# Patterns use gitignore syntax, so they are ANCHORED to the repo root with a
# leading slash. Without it, "README.md" would also match mod-shipped files such
# as config/NoChatReports/README.md, which do belong in a client install.

# Server deployment — consumed by Komodo, irrelevant to a client install
/compose.yaml
/compose.yml
/docker-compose.yml
/docker-compose.yaml
/.env
/.env.*

# Repo documentation
/README.md
/LICENSE

# Local debugging scratch — captured server logs, crash dumps. Not anchored,
# because these can legitimately be dropped anywhere while investigating.
# Kept out of git by .gitignore as well.
*.txt.bak
*.log
crash-reports/
logs/

# Claude Code working notes -- repo documentation, not pack content.
# Anchored, so it cannot match a mod-shipped CLAUDE.md under config/.
/CLAUDE.md

# BlueMap server config and addon packs. BlueMap is side="server", so no client
# install has any use for these. Managed on the VPS volume instead: git-tracked
# for review, never indexed. Anchored, so it cannot match a mod-shipped
# config/bluemap path.
/config/bluemap/
